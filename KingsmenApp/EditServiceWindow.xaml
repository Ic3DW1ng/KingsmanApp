<Window x:Class="KingsmenApp.EditServiceWindow" Background="{StaticResource BgBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Услуга" Width="720" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Услуга" Style="{StaticResource HeaderText}" Margin="0,0,0,20"/>

            <Border Width="240" Height="240" BorderBrush="#7F8FA6" BorderThickness="1" Background="White">
                <Image x:Name="ServiceImage" Stretch="Uniform" Margin="4"/>
            </Border>

            <Button Content="Выбрать изображение" Width="240" Height="40" Margin="0,20,0,0"
                    Style="{StaticResource RoundButton}" FontSize="14" Click="ChooseImage_Click"/>
        </StackPanel>

        
        <StackPanel Grid.Column="1" Margin="30,0,0,0">
            <TextBlock Text="Введите наименование услуги" Style="{StaticResource DarkLabel}"/>
            <TextBox x:Name="NameBox" Background="White"/>

            <TextBlock Text="Введите описание услуги" Style="{StaticResource DarkLabel}"/>
            <TextBox x:Name="DescriptionBox" Background="White"/>

            <TextBlock Text="Введите цена услуги" Style="{StaticResource DarkLabel}"/>
            <TextBox x:Name="PriceBox" Background="White"/>

            <TextBlock Text="Выберите тип услуги" Style="{StaticResource DarkLabel}"/>
            <ComboBox x:Name="TypeBox"/>

            <Button x:Name="SaveButton" Width="180" Height="45" Margin="0,25,0,0"
                    HorizontalAlignment="Center" Style="{StaticResource RoundButton}"
                    FontSize="16" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
