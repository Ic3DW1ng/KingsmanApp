<Window x:Class="KingsmenApp.AuthWindow" Background="{StaticResource BgBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Width="400" Height="490"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Width="260">
        <Border Width="90" Height="90" CornerRadius="45" Background="#C5DDF7"
                HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="👤" FontSize="44" FontFamily="Segoe UI Emoji"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Text="Авторизация" Style="{StaticResource HeaderText}"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Логин" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
        <TextBox x:Name="LoginBox" Width="165"/>

        <TextBlock Text="Пароль" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox" Width="165"/>

        <TextBlock x:Name="ErrorText" Foreground="#FFD2D2" TextAlignment="Center"
                   TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0"/>

        <Button Content="Войти" Width="170" Height="50" Margin="0,20,0,10"
                Style="{StaticResource RoundButton}" IsDefault="True"
                Click="LoginButton_Click"/>

        <Button Content="Регистрация" Style="{StaticResource LinkButton}"
                HorizontalAlignment="Center" Click="RegisterButton_Click"/>
    </StackPanel>
</Window>
