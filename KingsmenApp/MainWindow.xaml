<Window x:Class="KingsmenApp.MainWindow" Background="{StaticResource BgBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Главная" Width="400" Height="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Width="300">
        <TextBlock Text="Главная страница" Style="{StaticResource HeaderText}"
                   FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,40"/>

        <Button Content="Услуги" Height="60" Margin="0,0,0,25"
                Style="{StaticResource RoundButton}" Click="ServicesButton_Click"/>
        <Button Content="Сотрудники" Height="60" Margin="0,0,0,25"
                Style="{StaticResource RoundButton}" Click="EmployeesButton_Click"/>
        <Button Content="Клиенты" Height="60"
                Style="{StaticResource RoundButton}" Click="ClientsButton_Click"/>
    </StackPanel>
</Window>
