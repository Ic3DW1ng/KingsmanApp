<Window x:Class="KingsmenApp.ServicesWindow" Background="{StaticResource BgBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Услуги" Width="700" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Услуги" Style="{StaticResource HeaderText}" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="ServicesGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  Background="White" MouseDoubleClick="ServicesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ServiceType}" Width="120"/>
                <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat=N0}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить" Width="130" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource RoundButton}" FontSize="14" Click="Add_Click"/>
            <Button Content="Изменить" Width="130" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource RoundButton}" FontSize="14" Click="Edit_Click"/>
            <Button Content="Удалить" Width="130" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource RoundButton}" FontSize="14" Click="Delete_Click"/>
            <Button Content="Назад" Width="110" Height="40"
                    Style="{StaticResource RoundButton}" FontSize="14" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>
